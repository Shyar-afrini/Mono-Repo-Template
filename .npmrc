public-hoist-pattern[]=*drizzle*
auto-install-peers=true
strict-peer-dependencies=false

# Make RN/ecosystem deps visible at app level (fixes Metro + symlinks)
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=react-native
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=expo
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=@types/react
public-hoist-pattern[]=@shopify/flash-list


node-linker=hoisted
public-hoist-pattern[]=*expo-modules-autolinking
public-hoist-pattern[]=*expo-modules-core
public-hoist-pattern[]=*babel-preset-expo

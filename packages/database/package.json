{
  "name": "@mono-repo-template/database",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "ts": "./src/index.ts",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./edge": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "drizzle:generate:primary": "drizzle-kit generate --config=drizzle.primary.config.ts",
    "drizzle:migrate:primary": "drizzle-kit migrate --config=drizzle.primary.config.ts",
    "drizzle:push:primary": "drizzle-kit push --config=drizzle.primary.config.ts"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.4",
    "pg": "^8.12.0",
    "ts-node": "^10.9.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.19.11",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "0.44.4",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@mono-repo-template/backend": "workspace:*",
    "dotenv": "^17.2.2",
    "drizzle-zod": "^0.8.3"
  }
}
